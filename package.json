{
  "name": "artois-university-rebranding",
  "private": true,
  "version": "0.1.0",
  "description": "Rebranding non officiel de l'ENT de l'Université d'Artois",
  "author": "baptiste-may",
  "homepage": "https://github.com/baptiste-may/artois-university-rebranding",
  "repository": {
    "type": "git",
    "url": "https://github.com/baptiste-may/artois-university-rebranding.git"
  },
  "bugs": {
    "url": "https://github.com/baptiste-may/artois-university-rebranding/issues"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jquery": "^4.0.0",
    "jsdom": "^31.0.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.11",
    "vite-plugin-monkey": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "preact": "^11.2.0",
    "preact-render-to-string": "^6.8.2"
  }
}
